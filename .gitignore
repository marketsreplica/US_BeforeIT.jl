# Modified by MarketsReplica contributors; see CHANGES_FROM_UPSTREAM.md.
.env
# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

*.jld2
*.tex
!reports/**/*.tex
# LaTeX paper (U.S. ABM forecasting). Source, bibliography, figure scripts,
# vector figures and the compiled PDF are the user-facing deliverable and are
# versioned; LaTeX build intermediates are not.
!paper/**/*.tex
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
reports/us_calibration/*.aux
reports/us_calibration/*.fdb_latexmk
reports/us_calibration/*.fls
reports/us_calibration/*.log
reports/us_calibration/*.out
reports/us_calibration/*.pdf
tmp/
!2010Q1.jld2
!1996.jld2
!2010.jld2
*.h5

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/
docs/src/examples/

# File generated by Pkg, the package manager, based on a corresponding Project.toml
# It records a fixed state of all packages used by the project. As such, it should not be
# committed for packages, but should be committed for applications that require a static
# environment.
Manifest.toml

# other files
.DS_Store

### JupyterNotebooks ###
# gitignore template for Jupyter Notebooks
# website: http://jupyter.org/

.ipynb_checkpoints
*/.ipynb_checkpoints/*
__pycache__/
*.py[cod]

# IPython
profile_default/
ipython_config.py

# Remove previous ipynb_checkpoints
#   git rm -r .ipynb_checkpoints/

### macOS ###
# General
.DS_Store
.AppleDouble
.LSOverride

# Icon must end with two \r
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

### macOS Patch ###
# iCloud generated files
*.icloud

.vscode/settings.json

# images
*.png
*.jpg
*.jpeg

# simulation data folder
simulation_data/

# data files
*.csv
*.jld2

# Web UI runtime artifacts
apps/web/runs/
apps/web/experiments/
apps/web/*.log

# Local research papers and compiled reports are not repository source.
/literature/
/output/pdf/

# Reproducible Austria calibration pipeline cache (raw downloads are ~5 GB
# uncompressed). Compact, versioned outputs are intentionally committed.
scripts/austria/cache/
!scripts/austria/Manifest.toml
!data/austria/**/*.csv
!data/austria/**/*.jld2

# Reproducible U.S. pipeline: immutable public-source downloads, Parquet
# snapshots and the rebuildable DuckDB file remain local. Compact validation
# ledgers and model artifacts are intentionally versioned.
scripts/us/cache/
!scripts/us/Manifest.toml
data/us/raw/
data/us/curated/
data/us/db/
!data/us/validation/
!data/us/validation/*.md
!data/us/validation/*.toml
!data/us/validation/*.csv
!data/us/baselines/
!data/us/baselines/*.jld2
!data/us/calibration/
!data/us/calibration/*.jld2
!data/us/accounting/
!data/us/accounting/candidates/
!data/us/accounting/candidates/*.jld2
!scripts/us/accounting/fixtures/**/*.csv
!scripts/us/accounting/fixtures/**/manifest.toml
!output/us_calibration/*.csv
!output/us_calibration/*.json

# First-pass ABM vs statistical benchmark diagnostic. The compact score tables,
# per-origin diagnostics and manifests are versioned; the per-cell forecast files
# (~3.3 MB each) and the raw per-origin ensemble summaries (~850 KB each) are
# rebuildable from the driver and stay local.
!output/us_forecasting/abm_revised_comparison*/manifest.toml
!output/us_forecasting/abm_revised_comparison*/score_summaries.csv
!output/us_forecasting/abm_revised_comparison*/relative_scores.csv
!output/us_forecasting/abm_revised_comparison*/weighted_relative_scores.csv
!output/us_forecasting/abm_revised_comparison*/monte_carlo_errors.csv
!output/us_forecasting/abm_revised_comparison*/abm_origin_diagnostics.csv
!output/us_forecasting/abm_revised_comparison*/failures.csv
!output/us_forecasting/abm_revised_comparison*/current_outlook.csv

# Scored ABM-vs-benchmark comparison outputs and the commodity-balance
# reconciliation report. Compact score tables and manifests are versioned so a
# result can be re-read without re-running the 61-origin ensembles; the ensemble
# caches themselves are versioned too because they are what makes the scoring
# and the interval-coverage table reproducible without a re-simulation.
!output/us_forecasting/abm_v2_comparison/**/*.csv
!output/us_forecasting/abm_v2_comparison_outlook/*.csv
!output/us_forecasting/commodity_balance_reconciliation/*.csv
# `manifest.toml` would otherwise be caught by the `Manifest.toml` rule above on
# case-insensitive filesystems; these are run seals, not Pkg manifests.
!output/us_forecasting/abm_v2_comparison/**/manifest.toml
!output/us_forecasting/abm_v2_comparison_outlook/manifest.toml
